# ── Shared / Nest parked backend (optional) ──
NODE_ENV=production

# Database (Supabase Session pooler URI — URL-encode special chars in password)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres?schema=public

# Redis (optional for now)
REDIS_URL=

# JWT (use long random secrets in production)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Nest API (parked / optional later — not needed for single Vercel deploy)
PORT=4000
API_PREFIX=api
FRONTEND_URL=https://your-app.vercel.app

# Uploads (Nest local disk only; Next API uses data URLs)
UPLOAD_PROVIDER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Optional local Docker Postgres (docker compose)
POSTGRES_USER=chitfund
POSTGRES_PASSWORD=
POSTGRES_DB=chitfund

# Seed demo accounts (set before `npm run db:seed` — do not commit real values)
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_PASSWORD=

# ── Frontend / single Vercel deploy (apps/web) ──
# Same-origin App Router API. Omit or set /api.
NEXT_PUBLIC_API_URL=/api
DEFAULT_ORG_ID=
