# ── Shared environment (local / reference) ──
NODE_ENV=development

# Database (Supabase Session pooler URI — URL-encode special chars in password)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres?schema=public

# JWT (use long random secrets in production)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Optional local Docker Postgres (docker compose)
POSTGRES_USER=chitfund
POSTGRES_PASSWORD=
POSTGRES_DB=chitfund

# Seed demo accounts (set before `npm run db:seed` — do not commit real values)
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_PASSWORD=

# ── Frontend / Vercel deploy (apps/web) ──
# Same-origin App Router API. Omit or set /api.
NEXT_PUBLIC_API_URL=/api
DEFAULT_ORG_ID=
FRONTEND_URL=
CRON_SECRET=

# ── AI Agent (Voice Assistant — free tiers, no credit card) ──
GROQ_API_KEY=              # Get free at console.groq.com
GEMINI_API_KEY=            # Get free at aistudio.google.com

# ── WhatsApp Business API (optional — for customer notifications) ──
# Setup: https://developers.facebook.com → Create App → Add WhatsApp product
WHATSAPP_PHONE_ID=         # Your WhatsApp Business Phone Number ID
WHATSAPP_ACCESS_TOKEN=     # Permanent access token from Meta Business
