# Same-origin Next.js API (default if unset)
NEXT_PUBLIC_API_URL=/api

# Required for App Router /api routes (Prisma + JWT)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres?schema=public
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Optional
DEFAULT_ORG_ID=
FRONTEND_URL=
